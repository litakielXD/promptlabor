DATABASE_URL="file:./dev.db"

# Auth.js / NextAuth
AUTH_SECRET="change-me-to-a-long-random-secret"
NEXTAUTH_URL="https://mondschule.de/promptlabor"
NEXT_PUBLIC_BASE_PATH="/promptlabor"

# Admin notifications
ADMIN_EMAIL="admin@example.com"

# Optional initial/admin account for `npm run seed`.
# Set these only in the real server `.env`, not in committed files.
ADMIN_SEED_EMAIL="admin@example.com"
ADMIN_SEED_PASSWORD="change-me"
ADMIN_SEED_NAME="Admin"

# SMTP
SMTP_HOST="localhost"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# Alternative naming, used by some existing mondschule.de projects:
SMTP_PASSWORD=""
SMTP_FROM="Promptlabor <noreply@promptlabor.de>"
EMAIL_FROM=""
SMTP_SECURE="false"
SMTP_IGNORE_TLS="false"
SMTP_TLS_REJECT_UNAUTHORIZED="true"

# Uploads
UPLOAD_DIR="./public/uploads"
